<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_adk_memo" model="report.paperformat">
        <field name="name">ADK Bloc-Note - A4 Paysage</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_adk_memo" model="ir.actions.report">
        <field name="name">Journal du Bloc-Note</field>
        <field name="model">adk.stock.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">adk_stock_line_no_impact.report_adk_memo_template</field>
        <field name="report_file">adk_stock_line_no_impact.report_adk_memo_template</field>
        <field name="print_report_name">'Journal_Bloc_Note'</field>
        <field name="paperformat_id" ref="paperformat_adk_memo"/>
    </record>

    <template id="report_adk_memo_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <style>
                        table.adk-tbl th, table.adk-tbl td { padding: 4px 7px; vertical-align: top; }
                        table.adk-tbl tr { page-break-inside: avoid; }
                        table.adk-tbl thead { display: table-header-group; }
                    </style>
                    <h2 class="text-center">Journal des Mouvements - Bloc-Note de Stock</h2>
                    <p class="text-center">
                        Période du <strong><t t-esc="date_start"/></strong>
                        au <strong><t t-esc="date_end"/></strong>
                        &#160;|&#160; Statut : <strong><t t-esc="state_label"/></strong>
                    </p>
                    <p class="text-center text-muted" style="font-size:11px;">
                        Document de suivi interne - sans valeur comptable et sans impact sur le stock réel.
                    </p>

                    <h4 class="mt-3">1. Synthèse par article</h4>
                    <table class="table table-sm table-bordered adk-tbl">
                        <thead style="background-color:#f2f2f2;">
                            <tr style="page-break-inside:avoid;">
                                <th style="padding:4px 7px;">Article</th>
                                <th style="padding:4px 7px;" class="text-end">Entrées</th>
                                <th style="padding:4px 7px;" class="text-end">Sorties</th>
                                <th style="padding:4px 7px;" class="text-end">Solde période</th>
                                <th style="padding:4px 7px;" class="text-end">Dont à régulariser</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary" t-as="row">
                                <tr style="page-break-inside:avoid;">
                                    <td style="padding:4px 7px;vertical-align:top;"><t t-esc="row['name']"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(row['qty_in'])"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(row['qty_out'])"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;" class="text-end"><strong><t t-esc="fmt(row['qty_in'] - row['qty_out'])"/></strong></td>
                                    <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(row['pending'])"/></td>
                                </tr>
                            </t>
                            <tr style="page-break-inside:avoid;font-weight:bold;background-color:#f2f2f2;">
                                <td style="padding:4px 7px;vertical-align:top;">TOTAL</td>
                                <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(total_in)"/></td>
                                <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(total_out)"/></td>
                                <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(total_in - total_out)"/></td>
                                <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(total_pending)"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <h4 class="mt-4">2. Journal détaillé</h4>
                    <table class="table table-sm table-bordered adk-tbl">
                        <thead style="background-color:#f2f2f2;">
                            <tr style="page-break-inside:avoid;">
                                <th style="padding:4px 7px;">N°</th><th style="padding:4px 7px;">Date</th><th style="padding:4px 7px;">Article</th><th style="padding:4px 7px;">Sens</th>
                                <th style="padding:4px 7px;" class="text-end">Qté</th><th style="padding:4px 7px;">Type de mouvement</th><th style="padding:4px 7px;">Tiers</th>
                                <th style="padding:4px 7px;">Document d'origine</th><th style="padding:4px 7px;">Magasinier</th><th style="padding:4px 7px;">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="moves" t-as="move">
                                <tr style="page-break-inside:avoid;">
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.name"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.date" t-options='{"widget": "datetime"}'/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.adk_product_id.name"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;">
                                        <span t-if="move.type == 'in'">ENTRÉE (+)</span>
                                        <span t-if="move.type == 'out'">SORTIE (-)</span>
                                    </td>
                                    <td style="padding:4px 7px;vertical-align:top;" class="text-end"><t t-esc="fmt(move.qty)"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.move_type_id.name"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.memo_partner_id.name"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.origin_ref"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.user_id.name"/></td>
                                    <td style="padding:4px 7px;vertical-align:top;"><span t-field="move.status_id.name"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table class="table table-borderless mt-5" style="page-break-inside:avoid;">
                        <tr>
                            <td class="text-center">Le Magasinier<br/><br/><br/>______________________</td>
                            <td class="text-center">L'Économe / Gestionnaire de stock<br/><br/><br/>______________________</td>
                            <td class="text-center">Visa Direction<br/><br/><br/>______________________</td>
                        </tr>
                    </table>
                    <p class="text-muted" style="font-size:10px;">
                        Imprimé par <t t-esc="printed_by"/> le <t t-esc="printed_on"/>
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
